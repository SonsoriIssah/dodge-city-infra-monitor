# ---------------------------------------------------------------------------------------------------------
# Dodge City 3D Urban Infrastructure Monitoring prototype - environment configuration
#
#   cp .env.example .env      and set POSTGRES_PASSWORD
#
# .env is git-ignored; never commit real credentials. Real environment variables override this file.
# Every value below is the default used when the variable is unset (an empty value also means "use the
# default").
# ---------------------------------------------------------------------------------------------------------

# --- Database (PostgreSQL + PostGIS) ----------------------------------------------------------------------
# Precedence: a non-empty DATABASE_URL wins; otherwise the connection is built from the POSTGRES_* parts.
# Leave DATABASE_URL empty for local development. docker-compose sets it for the backend container
# (host "db", port 5432).
DATABASE_URL=
POSTGRES_HOST=localhost
# Port the application connects to (5433 on the development host: 5432 may belong to another PostgreSQL).
POSTGRES_PORT=5433
# Host port published by docker-compose for the db service (used by docker-compose only).
POSTGRES_HOST_PORT=5433
POSTGRES_DB=infra
POSTGRES_USER=infra
# Any characters work. Wrap the value in single quotes if it contains $, # or spaces, e.g. POSTGRES_PASSWORD='a$b #c'
POSTGRES_PASSWORD=change-me
# Database used by the pytest integration tests. Empty = the connection above with database "infra_test".
TEST_DATABASE_URL=

# --- Study area (configurable; changing it requires: python run_pipeline.py --refresh) --------------------
STUDY_AREA_SLUG=dodge-city-downtown
STUDY_AREA_NAME=Downtown Dodge City, Kansas
# south,west,north,east in WGS84 degrees (Overpass order). Everywhere else the order is west,south,east,north.
STUDY_AREA_BBOX=37.745,-100.030,37.762,-100.005
# Projected CRS for metric work (UTM zone of the study area; 32614 = WGS 84 / UTM zone 14N).
STUDY_AREA_UTM_SRID=32614
# IANA time zone of the study area (daily and weekly patterns follow local time).
TIMEZONE=America/Chicago
# Census GEOID of the incorporated place drawn as the "city limits" context outline (2018250 = Dodge City),
# or "auto" = the incorporated place that contains the centre of the study area.
TIGER_PLACE_GEOID=2018250

# --- Sensor source and simulation ("Simulated Sensor Data") -----------------------------------------------
# simulated = built-in deterministic simulator; http = poll HTTP_SOURCE_URL (see docs/real-sensor-integration.md)
SENSOR_SOURCE=simulated
HTTP_SOURCE_URL=
# Random seed: the same seed reproduces the same sensors, readings and injected events.
SIM_SEED=42
# First timestamp of the simulated window (ISO 8601 with UTC offset) and its length.
SIM_START=2026-09-01T00:00:00-05:00
SIM_DAYS=30
SIM_STEP_MINUTES=60
# Number of abnormal events injected into the simulated readings (ground truth for evaluation).
SIM_ANOMALY_EVENTS=40
# Share of sensors that lose a few consecutive hours of readings.
SIM_DROPOUT_RATE=0.12
# Number of simulated water mains (each hosts one pressure sensor).
SIM_WATER_MAINS=28

# --- Detection ("Prototype Anomaly Detection") ------------------------------------------------------------
# Robust z-score at or above which a single reading is a strong outlier.
DETECT_Z_STRONG=6.0
# Robust z-score at or above which an hour counts as flagged (needs persistence to become an anomaly).
DETECT_Z_MIN=3.0
# Window (hours) of the rolling-median detector for sustained shifts and drift.
DETECT_ROLLING_HOURS=6
# Isolation Forest score at or above which an hour corroborates a flag (never creates an anomaly by itself).
DETECT_IFOREST_THRESHOLD=0.62
# Flagged hours separated by at most this many hours are merged into one event.
DETECT_MERGE_GAP_HOURS=2

# --- Spatial analysis and "Derived Asset Health Score" ----------------------------------------------------
# Radius (m) for "infrastructure near an anomaly".
PROXIMITY_RADIUS_M=100
# Spatio-temporal clustering: distance (m) and time (h) scales, minimum anomalies and distinct sensors.
CLUSTER_EPS_M=200
CLUSTER_EPS_HOURS=48
CLUSTER_MIN_POINTS=3
CLUSTER_MIN_SENSORS=3
# Risk zones: hexagon edge length (m), kernel bandwidth (m), decay half-life (h), raw value that maps to 100.
RISK_HEX_EDGE_M=150
RISK_BANDWIDTH_M=250
RISK_HALF_LIFE_HOURS=72
RISK_REFERENCE=14.0
# Asset health: look-back window (days) and decay half-life (h) of resolved anomalies.
HEALTH_WINDOW_DAYS=7
HEALTH_HALF_LIFE_HOURS=48

# --- API --------------------------------------------------------------------------------------------------
API_HOST=0.0.0.0
# Port of the API (uvicorn). With docker compose the container always listens on 8000 and API_PORT is the
# host port it is published on (API_HOST does not apply there).
API_PORT=8000
# Comma-separated list of allowed origins, or * for any origin.
CORS_ORIGINS=*
# Key required in the X-API-Key header of POST /ingest/readings. Empty = the ingest endpoint is disabled.
INGEST_API_KEY=
# Serve the dashboard/ folder at / from the API process.
SERVE_DASHBOARD=true
# Start-up of the backend container (python -m backend.entrypoint): run the pipeline
# (run_pipeline.py --skip-download --skip-export) when the database has no finished detection run.
AUTO_SEED=true
# MapLibre style of the basemap (display only).
BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
